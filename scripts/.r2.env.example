# R2 credentials for scripts/build_basemap.sh.
# HOW TO USE:
#   1. cp scripts/.r2.env.example scripts/.r2.env
#   2. fill in the three blanks below
#   3. source scripts/.r2.env && bash scripts/build_basemap.sh
# scripts/.r2.env is gitignored, so your secret never gets committed.

export R2_ACCOUNT_ID=de154d51c0d25a1c9fbb3e3d5b5f5ff5
export R2_BUCKET=chainsfromchina-tiles

# From the R2 API token screen — the S3 credentials, NOT the long "Token value":
export R2_ACCESS_KEY=PASTE_ACCESS_KEY_ID
export R2_SECRET_KEY=PASTE_SECRET_ACCESS_KEY

# The bucket's Public Development URL (Settings -> Public Development URL), e.g. https://pub-xxxx.r2.dev
export R2_PUBLIC_BASE=PASTE_PUBLIC_URL

# Optional: export MAXZOOM=13   # lower = smaller/faster, higher = more street detail
