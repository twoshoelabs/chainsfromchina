<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly USPTO trademark pipeline-signal pass, Mondays 07:00 local (after the 06:00 daily). This
     Mac sleeps, so launchd runs it at the next wake, which is fine: a weekly trademark sweep is not
     time-critical and the collector is idempotent (deduped on serial), so a late or repeated run
     adds no duplicates. Writes only to pipeline_signals; never publishes the site.

     Dormant until USPTO_API_KEY is set in the repo's .env — with no key `chain_atlas uspto` skips.
     Install: cp scripts/com.dansilver.chain_atlas_uspto.plist ~/Library/LaunchAgents/
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.dansilver.chain_atlas_uspto.plist
     Remove:  launchctl bootout gui/$(id -u)/com.dansilver.chain_atlas_uspto -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.dansilver.chain_atlas_uspto</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/Users/dansilver/Projects/chain_atlas/scripts/run_uspto.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/dansilver/Projects/chain_atlas</string>
  <key>StartCalendarInterval</key><array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/dansilver/chain_atlas_data/logs/uspto.log</string>
  <key>StandardErrorPath</key><string>/Users/dansilver/chain_atlas_data/logs/uspto.log</string>
</dict></plist>
