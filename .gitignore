# All collected state lives in CHAIN_ATLAS_DATA, never in the repo.
.venv/
__pycache__/
*.pyc
.env
chain_atlas_data/
map/data/*.json

# R2 basemap credentials (local only)
.r2.env
scripts/.r2.env
manual/demographics_cache.json
.demo_attempt

# Pro-tier artifacts (pricing menus, exports) — access-controlled, never published or committed
pro/

# Source/evidence corpus — raw press/financial/analyst material (often copyrighted, large):
# local-only, never committed. The EXTRACTED facts get committed, the sources stay on the machine.
manual/sources/

# alert delivery cursor (per-channel local state)
manual/event_cursor.json
