# Where every byte of collected state lives. Code in git, data here.
US_CHAIN_ATLAS_DATA="$HOME/us_chain_atlas_data"
# Identify yourself. A locator census that hides who is asking has no business asking.
US_CHAIN_ATLAS_UA="us_chain_atlas/0.1 (+mailto:you@example.com; daily first-party locator census)"
# Politeness delay between requests, seconds.
US_CHAIN_ATLAS_DELAY_MIN=4
US_CHAIN_ATLAS_DELAY_MAX=8
