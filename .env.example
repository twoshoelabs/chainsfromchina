# Where every byte of collected state lives. Code in git, data here.
CHAIN_ATLAS_DATA="$HOME/chain_atlas_data"
# Identify yourself. A locator census that hides who is asking has no business asking.
CHAIN_ATLAS_UA="chain_atlas/0.1 (+mailto:you@example.com; daily first-party locator census)"
# Politeness delay between requests, seconds.
CHAIN_ATLAS_DELAY_MIN=4
CHAIN_ATLAS_DELAY_MAX=8
